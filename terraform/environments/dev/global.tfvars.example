project_name           = "team9-mini"
environment            = "dev"
aws_region             = "ap-northeast-2"
terraform_state_bucket = "team9-mini-dev-terraform-state"
terraform_state_region = "ap-northeast-2"
root_domain_name       = "skala-ai.com"
frontend_domain_name   = "front.team9.cloud.skala-ai.com"
cert_manager_email     = "skala@sk.com"
kubernetes_version     = "1.34"
general_node_instance_types = ["t3.medium"]
build_node_instance_types   = ["m6i.large"]
msk_broker_instance_type    = "kafka.m7g.large"
msk_kafka_version           = "3.7.x.kraft"
msk_number_of_broker_nodes  = 2
ecr_backend_repository_names = [
  "team9-user-service",
  "team9-redis-stream-mongo-consumer",
  "team9-login-service",
  "team9-socket-io-gateway",
  "team9-chat-service",
  "team9-room-service",
]
ecr_legacy_repository_names = [
  "team9-ui-vue",
  "team9-debezium-connect",
]
enable_debezium_connector        = true
debezium_plugin_bucket_arn       = "arn:aws:s3:::881490135253-msk-connect-plugins"
debezium_plugin_file_key         = "debezium/debezium-connector-mysql-1.9.7.Final-msk.zip"
msk_connect_kafkaconnect_version = "2.7.1"
debezium_mcu_count         = 1
debezium_worker_count      = 1
debezium_tasks_max         = 1
debezium_database_server_id    = "5401"
debezium_database_include_list = "app1"
debezium_topic_prefix          = "team9.dbserver1"
jenkins_hostname               = "jenkins.team9.cloud.skala-ai.com"
jenkins_git_credentials_id     = "github-scm"
jenkins_admin_secret_name      = "team9-mini/dev/jenkins/admin"
jenkins_admin_k8s_secret_name  = "jenkins-admin-credentials"
jenkins_git_credentials_secret_name = "team9-mini/dev/jenkins/git-credentials"
jenkins_git_k8s_secret_name    = "jenkins-git-credentials"
external_secrets_cluster_secret_store_name = "aws-secretsmanager"
frontend_pipeline_job_name     = "frontend-dev"
frontend_pipeline_repo_url     = "https://github.com/team-jdd-uta/frontend-ui-vue.git"
frontend_pipeline_repo_branch  = "main"
frontend_pipeline_jenkinsfile_path = "jenkins/Jenkinsfile"
backend_pipeline_repositories = [
  {
    job_name         = "backend-user-service-dev"
    repo_url         = "https://github.com/team-jdd-uta/backend-user-service.git"
    branch           = "main"
    jenkinsfile_path = "jenkins/Jenkinsfile"
  },
  {
    job_name         = "backend-redis-stream-mongo-consumer-dev"
    repo_url         = "https://github.com/team-jdd-uta/backend-redis-stream-mongo-consumer.git"
    branch           = "main"
    jenkinsfile_path = "jenkins/Jenkinsfile"
  },
  {
    job_name         = "backend-login-service-dev"
    repo_url         = "https://github.com/team-jdd-uta/backend-login-service.git"
    branch           = "main"
    jenkinsfile_path = "jenkins/Jenkinsfile"
  },
  {
    job_name         = "backend-socket-io-gateway-dev"
    repo_url         = "https://github.com/team-jdd-uta/backend-socket-io-gateway.git"
    branch           = "main"
    jenkinsfile_path = "jenkins/Jenkinsfile"
  },
  {
    job_name         = "backend-chat-service-dev"
    repo_url         = "https://github.com/team-jdd-uta/backend-chat-service.git"
    branch           = "main"
    jenkinsfile_path = "jenkins/Jenkinsfile"
  },
  {
    job_name         = "backend-room-service-dev"
    repo_url         = "https://github.com/team-jdd-uta/backend-room-service.git"
    branch           = "main"
    jenkinsfile_path = "jenkins/Jenkinsfile"
  },
]
az_count               = 2
nat_gateway_per_az     = false

common_tags = {
  Project     = "team9-mini"
  Team        = "team9"
  Environment = "dev"
  ManagedBy   = "terraform"
}
