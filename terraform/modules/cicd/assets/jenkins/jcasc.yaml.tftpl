jenkins:
  systemMessage: "Managed by Terraform, Helm, and JCasC."
  numExecutors: 0
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
  securityRealm:
    local:
      allowsSignup: false
      enableCaptcha: false
      users:
        - id: "${jenkins_admin_username_secret_value}"
          name: "Jenkins Admin"
          password: "${jenkins_admin_password_secret_value}"
  clouds:
    - kubernetes:
        name: "kubernetes"
        serverUrl: "https://kubernetes.default"
        namespace: "${jenkins_namespace}"
        jenkinsUrl: "${jenkins_url}"
        jenkinsTunnel: "${jenkins_tunnel}"
        containerCapStr: "10"
        connectTimeout: "5"
        readTimeout: "15"
        maxRequestsPerHostStr: "32"
        retentionTimeout: "5"
        waitForPodSec: "600"
        templates:
          - name: "default"
            namespace: "${jenkins_namespace}"
            label: "jenkins-agent"
            nodeUsageMode: "NORMAL"
            podRetention: Never
            serviceAccount: "${jenkins_agent_service_account}"
            containers:
              - name: "jnlp"
                image: "jenkins/inbound-agent:3355.v388858a_47b_33-19"
                args: "^$${computer.jnlpmac} ^$${computer.name}"
                workingDir: "/home/jenkins/agent"
                resourceRequestCpu: "512m"
                resourceRequestMemory: "512Mi"
                resourceLimitCpu: "512m"
                resourceLimitMemory: "512Mi"
credentials:
  system:
    domainCredentials:
      - credentials:
          - usernamePassword:
              id: "${jenkins_git_credentials_id}"
              scope: GLOBAL
              username: "${jenkins_git_username_secret_value}"
              password: "${jenkins_git_token_secret_value}"
              description: "Git credential for pipeline repositories"
unclassified:
  location:
    url: "${jenkins_url}/"
