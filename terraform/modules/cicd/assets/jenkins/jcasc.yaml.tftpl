jenkins:
  systemMessage: "Managed by Terraform, Helm, and JCasC."
  numExecutors: 0
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
credentials:
  system:
    domainCredentials:
      - credentials:
          - usernamePassword:
              id: "${jenkins_git_credentials_id}"
              scope: GLOBAL
              username: "${jenkins_git_username_secret_value}"
              password: "${jenkins_git_token_secret_value}"
              description: "Git credential for pipeline repositories"
unclassified:
  location:
    url: "http://jenkins.jenkins.svc.cluster.local:8080/"
